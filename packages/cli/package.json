{
	"name": "mcp-sentry",
	"version": "1.0.0",
	"description": "Static-analysis security linter for TypeScript MCP servers",
	"license": "MIT",
	"type": "module",
	"bin": {
		"mcp-sentry": "dist/bin.cjs"
	},
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"files": ["dist", "README.md", "LICENSE"],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"keywords": ["mcp", "security", "linter", "owasp", "static-analysis"],
	"dependencies": {
		"chalk": "^5.3.0",
		"commander": "^13.0.0",
		"ignore": "^5.3.2",
		"ora": "^8.1.1",
		"ts-morph": "^23.0.0",
		"which": "^4.0.0"
	},
	"devDependencies": {
		"@types/node": "^20.17.6",
		"@types/which": "^3.0.4",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"tsup": "^8.3.5",
		"tsx": "^4.21.0",
		"typescript": "^5.6.3",
		"vitest": "^2.1.5"
	}
}
