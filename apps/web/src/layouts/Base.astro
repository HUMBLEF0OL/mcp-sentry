---
export interface Props {
	title: string;
	description?: string;
	docs?: boolean;
}
const {
	title,
	description = 'Static-analysis security linter for TypeScript MCP servers.',
	docs = false,
} = Astro.props;

const navItems = [
	{ href: '/docs/install', label: 'Install' },
	{ href: '/docs/config', label: 'Config' },
	{ href: '/docs/rules', label: 'Rules' },
];

const sidebarSections = [
	{
		title: 'Get started',
		links: [
			{ href: '/docs/install', label: 'Install & usage' },
			{ href: '/docs/config', label: 'Configuration' },
		],
	},
	{
		title: 'Rules',
		links: [
			{ href: '/docs/rules', label: 'All rules' },
			{ href: '/rules/MCP01', label: 'MCP01 — Secrets' },
			{ href: '/rules/MCP02', label: 'MCP02 — Scope' },
			{ href: '/rules/MCP03', label: 'MCP03 — Poisoning' },
			{ href: '/rules/MCP04', label: 'MCP04 — Supply chain' },
			{ href: '/rules/MCP05', label: 'MCP05 — Injection' },
			{ href: '/rules/MCP07', label: 'MCP07 — Auth' },
			{ href: '/rules/MCP08', label: 'MCP08 — Logging' },
		],
	},
];

const repoUrl = 'https://github.com/HUMBLEF0OL/mcp-sentry';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="color-scheme" content="dark" />
		<title>{title} · mcp-sentry</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<style is:global>
			:root {
				/* Editorial palette — single grade-A green accent on dark neutrals.
				   No purple, no gradients, no glassmorphism, no rounded pills. */
				--bg:        #0c0e10;
				--bg-elev:   #14171b;
				--bg-panel:  #0f1216;
				--fg:        #d6d8d3;
				--fg-strong: #f1f2ee;
				--muted:     #7c828a;
				--muted-2:   #4f555c;
				--border:    #21262c;
				--border-strong: #2f3640;
				--accent:    #7dd181;
				--accent-dim:#2a4d2c;

				--sev-critical: #e06c5d;
				--sev-high:     #d99457;
				--sev-medium:   #c9b35c;
				--sev-low:      #6da3c4;

				--font-sans: ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
				--font-mono: ui-monospace, SFMono-Regular, 'JetBrains Mono', 'Fira Code', Menlo, Consolas, 'Liberation Mono', monospace;

				--measure: 68ch;
				--radius: 3px;
			}

			*, *::before, *::after { box-sizing: border-box; }

			html, body {
				margin: 0;
				padding: 0;
				background: var(--bg);
				color: var(--fg);
				font-family: var(--font-sans);
				font-size: 15.5px;
				line-height: 1.65;
				-webkit-font-smoothing: antialiased;
				text-rendering: optimizeLegibility;
			}
			::selection { background: var(--accent-dim); color: var(--fg-strong); }

			a {
				color: var(--fg-strong);
				text-decoration: none;
				border-bottom: 1px solid var(--muted-2);
				transition: border-color 120ms ease, color 120ms ease;
			}
			a:hover { color: var(--accent); border-bottom-color: var(--accent); }
			a.bare, a.bare:hover { border-bottom: none; }

			/* ───── Header ───── */
			.site-header {
				position: sticky;
				top: 0;
				z-index: 10;
				background: color-mix(in srgb, var(--bg) 92%, transparent);
				backdrop-filter: saturate(140%) blur(6px);
				border-bottom: 1px solid var(--border);
			}
			.site-header__inner {
				max-width: 1180px;
				margin: 0 auto;
				padding: 0.75rem 1.5rem;
				display: flex;
				align-items: center;
				gap: 2rem;
			}
			.brand {
				display: inline-flex;
				align-items: center;
				gap: 0.55rem;
				font-family: var(--font-mono);
				font-size: 0.95rem;
				color: var(--fg-strong);
				border-bottom: none;
				letter-spacing: -0.01em;
			}
			.brand:hover { color: var(--accent); }
			.brand__mark {
				display: inline-grid;
				place-items: center;
				width: 1.4rem;
				height: 1.4rem;
				border: 1px solid var(--accent);
				color: var(--accent);
				font-weight: 700;
				font-size: 0.7rem;
			}
			.brand__name span { color: var(--muted); }

			.site-nav {
				margin-left: auto;
				display: flex;
				align-items: center;
				gap: 1.5rem;
				font-family: var(--font-mono);
				font-size: 0.82rem;
			}
			.site-nav a {
				color: var(--muted);
				border-bottom: 1px solid transparent;
				padding-bottom: 2px;
			}
			.site-nav a[aria-current='page'] { color: var(--fg-strong); border-bottom-color: var(--accent); }
			.site-nav a:hover { color: var(--fg-strong); border-bottom-color: var(--accent); }
			.site-nav .gh {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				color: var(--fg);
				border: 1px solid var(--border-strong);
				padding: 0.3rem 0.6rem;
			}
			.site-nav .gh:hover { border-color: var(--accent); color: var(--accent); }
			.site-nav .gh svg { width: 14px; height: 14px; fill: currentColor; }

			/* ───── Layout ───── */
			.shell {
				max-width: 1180px;
				margin: 0 auto;
				padding: 2.5rem 1.5rem 4rem;
			}
			.shell--docs {
				display: grid;
				grid-template-columns: 220px minmax(0, 1fr);
				gap: 3rem;
			}
			@media (max-width: 820px) {
				.shell--docs { grid-template-columns: 1fr; gap: 1rem; }
				.sidebar { position: static !important; border-right: none !important; border-bottom: 1px solid var(--border); padding-bottom: 1rem; }
			}

			/* ───── Sidebar ───── */
			.sidebar {
				position: sticky;
				top: 4rem;
				align-self: start;
				font-family: var(--font-mono);
				font-size: 0.82rem;
				border-right: 1px solid var(--border);
				padding-right: 1rem;
			}
			.sidebar h4 {
				color: var(--muted);
				text-transform: uppercase;
				letter-spacing: 0.08em;
				font-size: 0.7rem;
				margin: 1.4rem 0 0.5rem;
				font-weight: 500;
			}
			.sidebar h4:first-child { margin-top: 0; }
			.sidebar ul { list-style: none; padding: 0; margin: 0; }
			.sidebar a {
				display: block;
				padding: 0.25rem 0.5rem;
				margin-left: -0.5rem;
				color: var(--muted);
				border-bottom: none;
				border-left: 2px solid transparent;
			}
			.sidebar a:hover { color: var(--fg-strong); }
			.sidebar a[aria-current='page'] {
				color: var(--accent);
				border-left-color: var(--accent);
				background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 8%, transparent), transparent);
			}

			/* ───── Content ───── */
			main { min-width: 0; }
			.prose { max-width: var(--measure); }
			h1, h2, h3, h4 {
				color: var(--fg-strong);
				font-weight: 600;
				line-height: 1.2;
				letter-spacing: -0.015em;
			}
			h1 {
				font-size: clamp(1.9rem, 2.6vw + 0.5rem, 2.7rem);
				margin: 0 0 0.5rem;
				font-family: var(--font-mono);
				font-weight: 600;
				letter-spacing: -0.025em;
			}
			h2 {
				font-size: 1.3rem;
				margin: 2.5rem 0 0.75rem;
				padding-bottom: 0.4rem;
				border-bottom: 1px solid var(--border);
				font-family: var(--font-mono);
			}
			h3 { font-size: 1.05rem; margin: 1.75rem 0 0.5rem; }
			p { margin: 0 0 1rem; }
			ul, ol { margin: 0 0 1rem; padding-left: 1.25rem; }
			li { margin: 0.2rem 0; }

			.lede {
				font-size: 1.1rem;
				color: var(--fg);
				max-width: 60ch;
				margin-bottom: 1.5rem;
			}
			.eyebrow {
				display: inline-block;
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: var(--accent);
				text-transform: uppercase;
				letter-spacing: 0.14em;
				margin-bottom: 1rem;
				padding: 0.15rem 0.5rem;
				border: 1px solid var(--accent-dim);
			}

			/* ───── Code ───── */
			code {
				font-family: var(--font-mono);
				font-size: 0.88em;
				background: var(--bg-elev);
				border: 1px solid var(--border);
				padding: 0.05rem 0.4rem;
				border-radius: var(--radius);
				color: var(--fg-strong);
			}
			pre {
				background: var(--bg-panel);
				border: 1px solid var(--border);
				border-left: 2px solid var(--accent);
				padding: 1rem 1.1rem;
				border-radius: var(--radius);
				overflow-x: auto;
				font-size: 0.85rem;
				line-height: 1.55;
				margin: 1rem 0 1.5rem;
				position: relative;
			}
			pre code { background: none; border: none; padding: 0; font-size: inherit; color: var(--fg); }

			/* ───── Tables ───── */
			.table-wrap { overflow-x: auto; margin: 1rem 0 1.5rem; }
			table { border-collapse: collapse; width: 100%; font-size: 0.92rem; }
			th, td {
				border-bottom: 1px solid var(--border);
				padding: 0.65rem 0.85rem;
				text-align: left;
				vertical-align: top;
			}
			th {
				font-weight: 500;
				color: var(--muted);
				text-transform: uppercase;
				letter-spacing: 0.06em;
				font-size: 0.72rem;
				font-family: var(--font-mono);
				border-bottom: 1px solid var(--border-strong);
			}
			tbody tr:hover { background: var(--bg-panel); }
			td code { background: transparent; border: none; padding: 0; color: var(--fg-strong); }

			/* ───── Severity badges (outline pills, mono uppercase) ───── */
			.badge {
				display: inline-block;
				padding: 0.05rem 0.45rem;
				border-radius: 2px;
				font-size: 0.68rem;
				font-family: var(--font-mono);
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				border: 1px solid currentColor;
				background: transparent;
				line-height: 1.5;
			}
			.badge + .badge { margin-left: 0.3rem; }
			.sev-critical { color: var(--sev-critical); }
			.sev-high     { color: var(--sev-high); }
			.sev-medium   { color: var(--sev-medium); }
			.sev-low      { color: var(--sev-low); }

			.status-pill {
				display: inline-block;
				font-family: var(--font-mono);
				font-size: 0.68rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				padding: 0.05rem 0.45rem;
				border-radius: 2px;
				border: 1px solid var(--border-strong);
				color: var(--muted);
			}
			.status-pill[data-status='active'] { color: var(--accent); border-color: var(--accent-dim); }

			/* ───── Footer ───── */
			.site-footer {
				border-top: 1px solid var(--border);
				margin-top: 5rem;
				padding: 1.5rem;
			}
			.site-footer__inner {
				max-width: 1180px;
				margin: 0 auto;
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				flex-wrap: wrap;
				font-family: var(--font-mono);
				font-size: 0.78rem;
				color: var(--muted);
			}
			.site-footer a { color: var(--muted); border-bottom-color: transparent; }
			.site-footer a:hover { color: var(--accent); border-bottom-color: var(--accent); }
		</style>
	</head>
	<body>
		<header class="site-header">
			<div class="site-header__inner">
				<a class="brand bare" href="/">
					<span class="brand__mark">A</span>
					<span class="brand__name">mcp-sentry<span> /v1</span></span>
				</a>
				<nav class="site-nav" aria-label="Primary">
					{
						navItems.map((item) => (
							<a
								href={item.href}
								aria-current={path === item.href || path.startsWith(`${item.href}/`) ? 'page' : undefined}
							>
								{item.label}
							</a>
						))
					}
					<a class="gh bare" href={repoUrl} rel="noopener noreferrer">
						<svg viewBox="0 0 16 16" aria-hidden="true">
							<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.69-.01-1.36-2.22.48-2.69-1.07-2.69-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.81.06 1.24.83 1.24.83.72 1.23 1.88.88 2.34.67.07-.52.28-.88.51-1.08-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.13 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.03 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.66 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.19 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
						</svg>
						GitHub
					</a>
				</nav>
			</div>
		</header>

		{
			docs ? (
				<div class="shell shell--docs">
					<aside class="sidebar" aria-label="Docs navigation">
						{sidebarSections.map((section) => (
							<>
								<h4>{section.title}</h4>
								<ul>
									{section.links.map((link) => (
										<li>
											<a
												href={link.href}
												aria-current={path === link.href ? 'page' : undefined}
											>
												{link.label}
											</a>
										</li>
									))}
								</ul>
							</>
						))}
					</aside>
					<main><div class="prose"><slot /></div></main>
				</div>
			) : (
				<div class="shell"><main><slot /></main></div>
			)
		}

		<footer class="site-footer">
			<div class="site-footer__inner">
				<span>MIT · OWASP MCP Top 10 · v1.0</span>
				<span><a href={repoUrl} class="bare">github.com/HUMBLEF0OL/mcp-sentry</a></span>
			</div>
		</footer>
	</body>
</html>
