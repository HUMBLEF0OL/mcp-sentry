---
import { ACTIVE_RULES } from '../data/rules.ts';
import Base from '../layouts/Base.astro';

const repoUrl = 'https://github.com/HUMBLEF0OL/mcp-sentry';
---
<Base title="Static-analysis security linter for MCP servers">
	<section class="hero">
		<div class="hero__copy">
			<span class="eyebrow">v1.0 · OWASP MCP Top 10</span>
			<h1>Lint your MCP&nbsp;server before<br />it lints your customers.</h1>
			<p class="lede">
				<strong>mcp-sentry</strong> is a zero-config CLI that scans TypeScript
				MCP servers for the OWASP MCP Top&nbsp;10 — secrets, scope, prompt
				injection, supply-chain risk, auth gaps. One command. Letter grade. SARIF for your CI.
			</p>
			<div class="hero__cta">
				<a class="btn btn--primary bare" href="/docs/install">Get started →</a>
				<a class="btn bare" href={repoUrl} rel="noopener noreferrer">View source</a>
			</div>
		</div>

		<aside class="grade-card" aria-label="Sample report card">
			<div class="grade-card__chrome">
				<span class="grade-card__dot" aria-hidden="true"></span>
				<span class="grade-card__dot" aria-hidden="true"></span>
				<span class="grade-card__dot" aria-hidden="true"></span>
				<span class="grade-card__title">~/server $ npx mcp-sentry scan .</span>
			</div>
			<pre class="grade-card__pre"><code><span class="c-muted">scanning</span> <span class="c-strong">./src</span> <span class="c-muted">(8 files)</span>
<span class="c-muted">──────────────────────────────────────</span>
<span class="c-strong">8</span> <span class="c-muted">checks ·</span> <span class="c-strong">3</span> <span class="c-muted">findings ·</span> <span class="c-strong">12 ms</span>

  <span class="sev-critical">CRIT</span>  MCP01  api-key in src/server.js:14
  <span class="sev-high">HIGH</span>  MCP05  exec(userInput) at l.42
  <span class="sev-low">LOW</span>   MCP08  console.log(secrets)

<span class="c-muted">┌─────────────────────────┐</span>
<span class="c-muted">│       GRADE   </span><span class="c-accent">A</span><span class="c-muted">         │</span>
<span class="c-muted">│  next: keep it green    │</span>
<span class="c-muted">└─────────────────────────┘</span></code></pre>
		</aside>
	</section>

	<section class="checks">
		<h2 class="section-title">What it checks</h2>
		<ul class="check-grid">
			{
				ACTIVE_RULES.map((rule) => (
					<li class="check-card">
						<a class="bare" href={`/rules/${rule.id}`}>
							<header>
								<code class="check-card__id">{rule.id}</code>
								<span class={`badge sev-${rule.severities[0]}`}>{rule.severities[0]}</span>
							</header>
							<h3>{rule.title}</h3>
							<p>{rule.summary}</p>
							<span class="check-card__more">Read rule →</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section class="next">
		<h2 class="section-title">Get started</h2>
		<ol class="next-list">
			<li>
				<span class="next-list__num">01</span>
				<div>
					<strong>Run a one-shot scan.</strong>
					<pre><code>npx mcp-sentry@latest scan ./server</code></pre>
				</div>
			</li>
			<li>
				<span class="next-list__num">02</span>
				<div>
					<strong>Wire it into CI.</strong> Add the <a href="/docs/install">GitHub Action</a> and fail the build below grade C.
				</div>
			</li>
			<li>
				<span class="next-list__num">03</span>
				<div>
					<strong>Show the badge.</strong> Cloudflare Worker + KV serves a Shields.io endpoint — see <a href="/docs/install">install docs</a>.
				</div>
			</li>
		</ol>
	</section>
</Base>

<style>
	/* Hero — asymmetric two-column, code panel as the visual anchor.
	   No gradient backgrounds, no centered megaphone. */
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
		gap: 3rem;
		align-items: start;
		margin-bottom: 4rem;
	}
	@media (max-width: 880px) {
		.hero { grid-template-columns: 1fr; gap: 2rem; }
	}
	.hero h1 {
		font-size: clamp(2rem, 3.4vw + 0.5rem, 3.1rem);
		margin: 0 0 1rem;
		line-height: 1.08;
	}
	.hero__cta { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 1.4rem; }
	.btn {
		display: inline-block;
		padding: 0.55rem 0.95rem;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		border: 1px solid var(--border-strong);
		color: var(--fg-strong);
		transition: border-color 120ms ease, color 120ms ease, background 120ms ease;
	}
	.btn:hover { border-color: var(--accent); color: var(--accent); }
	.btn--primary { background: var(--accent); color: #0c0e10; border-color: var(--accent); font-weight: 600; }
	.btn--primary:hover { background: transparent; color: var(--accent); }

	/* Terminal grade card — IDE chrome look. */
	.grade-card {
		border: 1px solid var(--border-strong);
		background: var(--bg-panel);
		font-family: var(--font-mono);
		box-shadow: 0 1px 0 #000, 0 0 0 1px var(--border) inset;
	}
	.grade-card__chrome {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.5rem 0.7rem;
		background: var(--bg-elev);
		border-bottom: 1px solid var(--border);
		font-size: 0.72rem;
		color: var(--muted);
	}
	.grade-card__dot {
		width: 9px; height: 9px; border-radius: 50%;
		background: var(--muted-2);
	}
	.grade-card__dot:nth-child(1) { background: var(--sev-critical); }
	.grade-card__dot:nth-child(2) { background: var(--sev-medium); }
	.grade-card__dot:nth-child(3) { background: var(--accent); }
	.grade-card__title { margin-left: 0.5rem; }
	.grade-card__pre {
		margin: 0;
		border: none;
		border-left: none;
		background: transparent;
		font-size: 0.78rem;
		line-height: 1.55;
		padding: 1rem 1.1rem;
	}
	.grade-card__pre .c-muted { color: var(--muted); }
	.grade-card__pre .c-strong { color: var(--fg-strong); }
	.grade-card__pre .c-accent { color: var(--accent); font-weight: 700; }

	/* Section titles — tag-style with hash prefix. */
	.section-title {
		font-family: var(--font-mono);
		font-size: 0.95rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--muted);
		margin: 0 0 1.25rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--border);
	}
	.section-title::before { content: '# '; color: var(--accent); }

	/* Check grid — sharp-edged cards, no rounded inflated tiles. */
	.checks { margin-bottom: 4rem; }
	.check-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 0;
		border-top: 1px solid var(--border);
		border-left: 1px solid var(--border);
	}
	.check-card {
		border-right: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}
	.check-card a {
		display: block;
		padding: 1.1rem 1.1rem 1.2rem;
		height: 100%;
		color: var(--fg);
		transition: background 120ms ease;
	}
	.check-card a:hover { background: var(--bg-panel); }
	.check-card header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.6rem;
	}
	.check-card__id {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--muted);
		background: transparent;
		border: none;
		padding: 0;
	}
	.check-card h3 {
		margin: 0 0 0.4rem;
		font-size: 0.98rem;
		color: var(--fg-strong);
		font-weight: 600;
	}
	.check-card p {
		margin: 0 0 0.7rem;
		font-size: 0.88rem;
		color: var(--muted);
		line-height: 1.5;
	}
	.check-card__more {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--accent);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	/* Next steps — numbered editorial list, no checkmark icons. */
	.next-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.next-list li {
		display: grid;
		grid-template-columns: 56px 1fr;
		gap: 1rem;
		align-items: start;
		padding: 1.1rem 0;
		border-top: 1px solid var(--border);
	}
	.next-list li:last-child { border-bottom: 1px solid var(--border); }
	.next-list__num {
		font-family: var(--font-mono);
		font-size: 1.1rem;
		color: var(--accent);
		letter-spacing: 0;
		font-weight: 600;
	}
	.next-list pre { margin: 0.5rem 0 0; }
</style>
